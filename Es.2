#include <stdio.h>
#include <stdlib.h>
#include <fcntl.h>
#include <sys/stat.h>
#include <unistd.h>
#include <string.h>
#include <signal.h>
#include <errno.h>

#define FIFO_PATH "/tmp/loop"
#define BUF_SIZE 256

int main(void) {
    if (mkfifo(FIFO_PATH, 0666) == -1 && errno != EEXIST) {
        perror("Errore mkfifo");
        exit(1);
    }

    pid_t pid = fork();
    if (pid < 0) {
        perror("Errore fork");
        exit(1);
    }

    if (pid == 0) {
        signal(SIGPIPE, SIG_IGN);
        sleep(1);

        int fd = open(FIFO_PATH, O_WRONLY);
        if (fd == -1) {
            perror("Errore open client");
            exit(1);
        }

        char buffer[BUF_SIZE];
        while (1) {
            if (fgets(buffer, sizeof(buffer), stdin) == NULL) {
                break;
            }

            ssize_t n = write(fd, buffer, strlen(buffer));
            if (n == -1) {
                break;
            }

            buffer[strcspn(buffer, "\r\n")] = 0;
            if (strcmp(buffer, "QUIT") == 0) {
                break;
            }
        }

        close(fd);
        exit(0);
    } else {
        int fd = open(FIFO_PATH, O_RDONLY);
        if (fd == -1) {
            perror("Errore open server");
            exit(1);
        }

        char buffer[BUF_SIZE];
        ssize_t n;

        while (1) {
            n = read(fd, buffer, sizeof(buffer) - 1);
            if (n > 0) {
                buffer[n] = '\0';
                buffer[strcspn(buffer, "\r\n")] = 0;

                if (strcmp(buffer, "QUIT") == 0) {
                    printf("[SERVER]: Ricevuto QUIT, chiusura\n");
                    break;
                }

                printf("[SERVER]: %s\n", buffer);
            } else if (n == 0) {
                break;
            }
        }

        close(fd);
        unlink(FIFO_PATH);
    }
    return 0;
}
